rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 👤 Users Collection (Allows cross-device registration, login and profile updates)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 🤝 Referral Commissions Collection
    match /commissions/{commissionId} {
      allow read, write: if true;
    }

    // 🎮 Games Collection (Public lobby matches, Admin managed)
    match /games/{gameId} {
      allow read, write: if true;
    }

    // 🎟️ Tickets Collection
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // 💳 Wallet Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // 📥 Deposit Requests (Recharge & UTR Verification)
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // 📤 Withdrawal Requests (Payout)
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // 🏆 Winners Collection (Public leaderboards)
    match /winners/{winnerId} {
      allow read, write: if true;
    }

    // ⚙️ System settings / Notifications / Admins
    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
